# QuantumGuard AI - Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# NEVER commit real secrets or production credentials to version control.

# Application Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (Relative to backend/ directory)
DATABASE_URL=sqlite:///./data/quantumguard.db

# Audio Storage Directory
AUDIO_STORAGE_PATH=./data/audio_samples

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# Security & Secret Key (Replace with strong random key in production)
SECRET_KEY=change_this_to_a_secure_random_string_for_production
